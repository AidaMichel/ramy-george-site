{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "module": "Preserve", "moduleResolution": "bundler",
    "jsx": "preserve", "strict": false, "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true,
    "resolveJsonModule": true, "noEmit": true, "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
