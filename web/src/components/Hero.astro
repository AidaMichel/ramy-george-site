---
import {getSite} from '../lib/content'
import Img from './Img.astro'
const site = await getSite()
const {hero, settings} = site
const cta = hero.ctaTarget === 'work' ? '/work/' : '#work'
const [first, ...rest] = settings.siteName.split(' ')
const [lead, ...others] = settings.supportingSkills
const useEditorialPortrait = hero.mode === 'none'
const editorialSrc = '/hero-rg-approved.webp?v=3'
---
<section class:list={['hero wrap', {'has-visual': useEditorialPortrait, editorial: useEditorialPortrait}]} aria-labelledby="hero-name">
  <div class="text">
    <h1 id="hero-name">{first}{rest.length > 0 && <><br />{rest.join(' ')}</>}</h1>
    <div class="meta">
      <div>
        <p class="title">{settings.professionalTitle}</p>
        {lead && <p class="skills"><strong>{lead}</strong>{others.length > 0 && <span class="muted"> · {others.join(' · ')}</span>}</p>}
        <div class="cta-row"><a class="cta" href={cta}>{hero.ctaLabel}</a></div>
      </div>
      {false && hero.shortLine && <p class="line muted">{hero.shortLine}</p>}
    </div>
  </div>

  {useEditorialPortrait && (
    <div class="visual editorial-portrait">
      <div class="editorial-frame">
        <img src={editorialSrc} alt="" aria-hidden="true" />
      </div>
    </div>
  )}
</section>
<script>
  const v = document.querySelector<HTMLVideoElement>('[data-reel]')
  const b = document.querySelector<HTMLButtonElement>('[data-reel-toggle]')
  if (v && b) {
    const set = (paused: boolean) => { paused ? v.pause() : v.play().catch(() => {}); b.textContent = paused ? 'Play' : 'Pause'; b.setAttribute('aria-pressed', String(paused)) }
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) set(true)
    b.addEventListener('click', () => set(!v.paused))
  }
</script>
<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(520px, 1.08fr);
    gap: clamp(8px, 1.3vw, 22px);
    padding-top: 0;
    padding-bottom: clamp(12px, 1.8vw, 24px);
    min-height: clamp(560px, calc(100svh - 76px), 760px);
    align-items: stretch;
    position: relative;
    overflow: clip;
  }
  .text {
    min-width: 0;
    position: relative;
    z-index: 2;
    align-self: center;
    padding-block: clamp(24px, 4vw, 54px);
  }
  h1 {
    font-size: clamp(76px, 10.8vw, 172px);
    line-height: .84;
    font-weight: 600;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    font-stretch: 88%;
  }
  .meta { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--gap); margin-top: clamp(30px, 4vw, 56px); }
  .title { font-size: clamp(26px, 3vw, 44px); line-height: 1; font-weight: 600; letter-spacing: -0.02em; text-transform: uppercase; }
  .skills { margin-top: 18px; font-size: 15px; line-height: 1.7; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; }
  .skills strong { font-weight: 700; color: var(--text); }
  .line { width: min(432px, 40%); font-size: 18px; line-height: 1.55; margin-bottom: 6px; }
  .cta-row { margin-top: 36px; }
  .cta { display: inline-flex; align-items: center; height: 52px; padding: 0 22px; border: 1px solid var(--text); font-size: 16px; font-weight: 600; }
  .cta:hover { border-color: var(--acc); }

  .visual {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: stretch;
    align-self: stretch;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 20px 46px rgba(0,0,0,.16));
  }
  .editorial-portrait {
    align-self: stretch;
    width: 126%;
    height: 100%;
    margin-left: -15%;
    margin-right: -8%;
    transform: none;
  }
  .editorial-frame {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    aspect-ratio: auto;
    overflow: visible;
    background: transparent;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.58) 5%, #000 18%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.58) 5%, #000 18%, #000 100%);
  }
  .editorial-frame::before {
    content: '';
    position: absolute;
    inset: 7% 2% 3% 10%;
    z-index: -1;
    pointer-events: none;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 69% 50%, rgba(255,190,80,.13), rgba(255,210,28,.035) 42%, transparent 72%);
    filter: blur(36px);
    opacity: .9;
  }
  .editorial-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--bg) 0%, rgba(22,21,19,.18) 6%, rgba(22,21,19,.035) 15%, rgba(22,21,19,0) 28%),
      linear-gradient(180deg, rgba(22,21,19,0) 0%, rgba(22,21,19,0) 86%, rgba(22,21,19,.08) 100%),
      radial-gradient(circle at 78% 18%, rgba(255,190,80,.045), transparent 27%),
      radial-gradient(circle at 70% 66%, rgba(255,210,28,.025), transparent 32%);
  }
  .editorial-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 61% center;
    filter: brightness(1.32) contrast(1.01) saturate(1.04);
  }

  .frame { display: block; aspect-ratio: 4 / 5; background: var(--s1); overflow: hidden; position: relative; }
  .frames { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .reel { aspect-ratio: 16 / 9; }
  .reel video { width: 100%; height: 100%; object-fit: cover; }
  .reel-toggle { position: absolute; right: 10px; bottom: 10px; background: var(--bg); border: 1px solid var(--rule); padding: 6px 10px; font-size: 12px; cursor: pointer; }

  @media (max-width: 1100px) {
    .hero { grid-template-columns: minmax(0, .96fr) minmax(390px, 1.04fr); min-height: auto; align-items: center; }
    .editorial-portrait { width: 121%; margin-left: -13%; margin-right: -7%; }
    h1 { font-size: clamp(74px, 10.4vw, 136px); }
  }
  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; align-items: start; }
    .visual { width: 100%; max-width: none; margin-top: 6px; filter: none; }
    .editorial-portrait { width: 108%; margin-left: -4%; margin-right: -4%; transform: none; }
    .editorial-frame {
      height: auto;
      min-height: 0;
      aspect-ratio: 1.18 / 1;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 11%, #000 84%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 11%, #000 84%, transparent 100%);
    }
    .editorial-frame::after {
      background:
        linear-gradient(180deg, var(--bg) 0%, rgba(22,21,19,.08) 13%, rgba(22,21,19,0) 36%, rgba(22,21,19,.20) 100%);
    }
    .editorial-frame img {
      object-position: center;
      filter: brightness(1.28) contrast(1) saturate(1.03);
    }
  }
  @media (max-width: 719px) {
    .meta { flex-direction: column; align-items: flex-start; gap: 0; margin-top: 28px; }
    .meta > div { display: contents; }
    .title { order: 1; }
    .skills { order: 2; font-size: 12px; margin-top: 12px; }
    .line { order: 3; width: auto; font-size: 16px; line-height: 1.5; margin: 22px 0 0; }
    .cta-row { order: 4; margin-top: 28px; }
    .cta { height: 48px; padding: 0 20px; font-size: 15px; }
    .editorial-frame { aspect-ratio: 1.08 / 1; }
  }
</style>
