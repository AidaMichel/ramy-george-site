---
import {getSite} from '../lib/content'
const site = await getSite()
const {hero, settings} = site
const cta = hero.ctaTarget === 'work' ? '/work/' : '#work'
const [first, ...rest] = settings.siteName.split(' ')
const [lead, ...others] = settings.supportingSkills
const editorialSrc = '/hero-ramy-final.webp'
---
<section class="hero wrap" aria-labelledby="hero-name">
  <div class="text">
    <h1 id="hero-name">{first}{rest.length > 0 && <><br />{rest.join(' ')}</>}</h1>
    <div class="meta">
      <p class="title">{settings.professionalTitle}</p>
      {lead && <p class="skills"><strong>{lead}</strong>{others.length > 0 && <span class="muted"> · {others.join(' · ')}</span>}</p>}
      <div class="cta-row"><a class="cta" href={cta}>{hero.ctaLabel}</a></div>
    </div>
  </div>

  <div class="visual" aria-label="Ramy George at his editing workstation">
    <div class="editorial-frame">
      <img src={editorialSrc} alt="Ramy George editing at his workstation" />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(460px, 1.05fr);
    gap: clamp(20px, 3vw, 48px);
    padding-top: clamp(44px, 5.5vw, 80px);
    align-items: end;
    min-height: min(860px, calc(100vh - 80px));
    overflow: hidden;
  }
  .text { min-width: 0; position: relative; z-index: 2; padding-bottom: clamp(36px, 5vw, 74px); }
  h1 {
    font-size: clamp(76px, 10.6vw, 170px);
    line-height: .84;
    font-weight: 600;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    font-stretch: 88%;
    max-width: 5.8ch;
  }
  .meta { margin-top: clamp(32px, 4.4vw, 60px); }
  .title { font-size: clamp(26px, 3vw, 44px); line-height: 1; font-weight: 600; letter-spacing: -0.02em; text-transform: uppercase; }
  .skills { margin-top: 18px; font-size: 15px; line-height: 1.7; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; }
  .skills strong { font-weight: 700; color: var(--text); }
  .cta-row { margin-top: 36px; }
  .cta { display: inline-flex; align-items: center; height: 52px; padding: 0 22px; border: 1px solid var(--text); font-size: 16px; font-weight: 600; transition: border-color 160ms ease, color 160ms ease; }
  .cta:hover, .cta:focus-visible { border-color: var(--acc); color: var(--acc); }

  .visual { min-width: 0; align-self: stretch; display: flex; align-items: flex-end; }
  .editorial-frame {
    position: relative;
    width: 100%;
    height: clamp(560px, 48vw, 760px);
    overflow: hidden;
    background: var(--bg);
  }
  .editorial-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--bg) 0%, rgba(22,21,19,.72) 7%, rgba(22,21,19,.16) 24%, rgba(22,21,19,0) 48%),
      linear-gradient(180deg, rgba(22,21,19,0) 68%, var(--bg) 100%);
  }
  .editorial-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 1100px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(380px, .88fr); min-height: auto; }
    h1 { font-size: clamp(74px, 10.2vw, 136px); }
    .editorial-frame { height: clamp(520px, 52vw, 680px); }
  }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; align-items: start; }
    .text { padding-bottom: 0; }
    .visual { width: 100%; margin-top: 8px; }
    .editorial-frame { height: auto; aspect-ratio: 1 / 1; }
    .editorial-frame::after {
      background:
        linear-gradient(180deg, var(--bg) 0%, rgba(22,21,19,.08) 16%, rgba(22,21,19,0) 54%, var(--bg) 100%);
    }
  }

  @media (max-width: 719px) {
    .hero { padding-top: 34px; }
    .title { font-size: clamp(24px, 8vw, 34px); }
    .skills { font-size: 12px; margin-top: 12px; }
    .cta-row { margin-top: 28px; }
    .cta { height: 48px; padding: 0 20px; font-size: 15px; }
    .visual { margin-top: 24px; }
  }
</style>
