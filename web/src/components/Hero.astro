---
import {getSite} from '../lib/content'
interface Props { hasWorkAnchor?: boolean }
const {hasWorkAnchor = true} = Astro.props
const site = await getSite()
const {hero, settings} = site
const cta = hero.ctaTarget === 'work' || !hasWorkAnchor ? '/work/' : '#work'
const [first, ...rest] = settings.siteName.split(' ')
const displaySkills = settings.supportingSkills.map((skill) => skill.trim().toLowerCase() === 'sound' ? 'Sound Design' : skill)
const [lead, ...others] = displaySkills
const storySkills = others.slice(0, 4).map((x) => x.toLowerCase())
const storyList = storySkills.length > 1
  ? `${storySkills.slice(0, -1).join(', ')} and ${storySkills.at(-1)}`
  : storySkills[0] || ''
const storyLine = hero.positioningLine || (lead
  ? 'The edit is the spine — motion, design and sound design make every beat land.'
  : hero.shortLine)
const fallbackHero = '/hero-rg-approved.webp?v=7'
const editorialSrc = hero.mode === 'none'
  ? (hero.useDashboardImage && hero.image?.src ? hero.image.src : fallbackHero)
  : (hero.image?.src || hero.showreelPoster?.src || fallbackHero)
const frameItems = (hero.frames || []).filter((f) => f.img?.src)
const showReel = hero.mode === 'showreel' && !!hero.showreel
const showFrames = hero.mode === 'multiframe' && frameItems.length > 0
---
<section class="hero wrap has-visual editorial" aria-labelledby="hero-name">
  <div class="text">
    <h1 id="hero-name">{first}{rest.length > 0 && <><br />{rest.join(' ')}</>}</h1>
    <div class="meta">
      <div>
        <p class="title">{settings.professionalTitle}</p>
        {lead && <p class="skills"><strong>{lead}</strong>{others.length > 0 && <span class="muted"> · {others.join(' · ')}</span>}</p>}
        {storyLine && <p class="story muted">{storyLine}</p>}
        <div class="cta-row"><a class="cta" href={cta}>{hero.ctaLabel}</a></div>
      </div>
      {false && hero.shortLine && <p class="line muted">{hero.shortLine}</p>}
    </div>
  </div>

  <div class="visual editorial-portrait">
    {showReel ? (
      <div class="editorial-frame reel">
        <video src={hero.showreel} poster={hero.showreelPoster?.src || editorialSrc} muted loop playsinline autoplay preload="metadata" data-reel aria-label="Ramy George showreel preview"></video>
        <button type="button" class="reel-toggle" data-reel-toggle aria-pressed="false">Pause</button>
      </div>
    ) : showFrames ? (
      <div class:list={['editorial-frame', 'frames', {'one-frame': frameItems.length === 1}]}>
        {frameItems.slice(0, 4).map((f) => (
          <span class="frame-item"><img src={f.img!.src} alt="" aria-hidden="true" /></span>
        ))}
      </div>
    ) : (
      <div class="editorial-frame">
        <img src={editorialSrc} alt="" aria-hidden="true" fetchpriority="high" decoding="async" data-hero-img data-fallback={fallbackHero} />
      </div>
    )}
  </div>
</section>
<script>
  const heroImg = document.querySelector<HTMLImageElement>('[data-hero-img]')
  if (heroImg) {
    heroImg.addEventListener('error', () => {
      const fallback = heroImg.dataset.fallback
      if (fallback && !heroImg.src.includes(fallback.split('?')[0])) heroImg.src = fallback
    })
  }

  const v = document.querySelector<HTMLVideoElement>('[data-reel]')
  const b = document.querySelector<HTMLButtonElement>('[data-reel-toggle]')
  if (v && b) {
    const set = (paused: boolean) => { paused ? v.pause() : v.play().catch(() => {}); b.textContent = paused ? 'Play' : 'Pause'; b.setAttribute('aria-pressed', String(paused)) }
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) set(true)
    b.addEventListener('click', () => set(!v.paused))
  }
</script>
<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(520px, 1.08fr);
    gap: clamp(8px, 1.3vw, 22px);
    padding-top: 0;
    padding-bottom: clamp(12px, 1.8vw, 24px);
    min-height: clamp(560px, calc(100svh - 76px), 760px);
    align-items: stretch;
    position: relative;
    overflow: clip;
  }
  .text {
    min-width: 0;
    position: relative;
    z-index: 2;
    align-self: center;
    padding-block: clamp(24px, 4vw, 54px);
  }
  h1 {
    font-size: clamp(76px, 10.8vw, 172px);
    line-height: .84;
    font-weight: 600;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    font-stretch: 88%;
  }
  .meta { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--gap); margin-top: clamp(30px, 4vw, 56px); }
  .title { font-size: clamp(26px, 3vw, 44px); line-height: 1; font-weight: 600; letter-spacing: -0.02em; text-transform: uppercase; }
  .skills { margin-top: 18px; font-size: 15px; line-height: 1.7; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; }
  .skills strong { font-weight: 700; color: var(--text); }
  .story { margin-top: 16px; max-width: 52ch; font-size: 16px; line-height: 1.48; letter-spacing: -.005em; text-wrap: balance; }
  .line { width: min(432px, 40%); font-size: 18px; line-height: 1.55; margin-bottom: 6px; }
  .cta-row { margin-top: 30px; }
  .cta { display: inline-flex; align-items: center; height: 52px; padding: 0 22px; border: 1px solid var(--text); font-size: 16px; font-weight: 600; }
  .cta:hover { border-color: var(--acc); }

  .visual {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: stretch;
    align-self: stretch;
    position: relative;
    z-index: 1;
    isolation: isolate;
    filter:
      drop-shadow(0 28px 64px rgba(0,0,0,.24))
      drop-shadow(0 0 46px rgba(255,178,82,.035));
  }
  .visual::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 12% -4% 8% 8%;
    pointer-events: none;
    border-radius: 48%;
    background:
      radial-gradient(ellipse at 72% 48%, rgba(255,170,74,.13), rgba(255,193,98,.045) 36%, transparent 70%);
    filter: blur(52px);
    opacity: .78;
  }
  .editorial-portrait {
    align-self: stretch;
    width: 120%;
    height: 100%;
    margin-left: -12%;
    margin-right: -7%;
    transform: translate3d(0,-2px,0);
    will-change: transform;
  }
  .editorial-frame {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    aspect-ratio: auto;
    overflow: visible;
    background: transparent;
    z-index: 1;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.12) 7%, rgba(0,0,0,.48) 17%, rgba(0,0,0,.84) 29%, #000 41%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.12) 7%, rgba(0,0,0,.48) 17%, rgba(0,0,0,.84) 29%, #000 41%, #000 100%);
  }
  .editorial-frame::before {
    content: '';
    position: absolute;
    inset: 6% 1% 2% 8%;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 71% 47%, rgba(255,183,92,.08), rgba(255,200,120,.02) 40%, transparent 72%);
    filter: blur(30px);
    opacity: .8;
  }
  .editorial-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      linear-gradient(90deg, var(--bg) 0%, rgba(22,21,19,.30) 7%, rgba(22,21,19,.07) 19%, rgba(22,21,19,0) 38%),
      linear-gradient(180deg, rgba(22,21,19,.48) 0%, rgba(22,21,19,.10) 7%, rgba(22,21,19,0) 18%, rgba(22,21,19,0) 84%, rgba(22,21,19,.16) 100%),
      radial-gradient(ellipse at 74% 45%, rgba(255,169,78,.105), rgba(255,188,100,.035) 35%, transparent 61%),
      radial-gradient(ellipse at 63% 72%, rgba(255,205,128,.055), transparent 44%);
  }
  .editorial-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    position: relative;
    z-index: 1;
    object-position: 61% center;
    filter: brightness(1.46) contrast(.98) saturate(1.02) sepia(.035);
  }

  .frames { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .frames.one-frame { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  .frame-item { min-width: 0; min-height: 0; overflow: hidden; background: var(--media); }
  .frames .frame-item img { width: 100%; height: 100%; object-fit: cover; }
  .reel video { width: 100%; height: 100%; object-fit: cover; }
  .reel-toggle { position: absolute; right: 12px; bottom: 12px; z-index: 2; background: rgba(22,21,19,.88); border: 1px solid var(--rule); border-radius: 999px; padding: 7px 12px; font-size: 12px; cursor: pointer; }

  @media (max-width: 1100px) {
    .hero { grid-template-columns: minmax(0, .96fr) minmax(390px, 1.04fr); min-height: auto; align-items: center; }
    .editorial-portrait { width: 117%; margin-left: -10%; margin-right: -6%; }
    h1 { font-size: clamp(74px, 10.4vw, 136px); }
  }
  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; align-items: start; }
    .visual { width: 100%; max-width: none; margin-top: 6px; filter: none; }
    .editorial-portrait { width: 108%; margin-left: -4%; margin-right: -4%; transform: none; }
    .editorial-frame {
      height: auto;
      min-height: 0;
      aspect-ratio: 1.18 / 1;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 11%, #000 84%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 11%, #000 84%, transparent 100%);
    }
    .editorial-frame::after {
      background:
        linear-gradient(180deg, var(--bg) 0%, rgba(22,21,19,.08) 13%, rgba(22,21,19,0) 36%, rgba(22,21,19,.20) 100%);
    }
    .editorial-frame img {
      object-position: center;
      filter: brightness(1.34) contrast(.99) saturate(1.01) sepia(.025);
    }
  }
  @media (max-width: 719px) {
    .text { padding-block: 24px 16px; }
    h1 { font-size: clamp(58px, 18vw, 92px); line-height: .86; }
    .title { font-size: clamp(24px, 7.2vw, 34px); }
    .meta { flex-direction: column; align-items: flex-start; gap: 0; margin-top: 28px; }
    .meta > div { display: contents; }
    .title { order: 1; }
    .skills { order: 2; font-size: 12px; margin-top: 12px; }
    .story { order: 3; max-width: 34ch; margin-top: 14px; font-size: 15px; line-height: 1.45; }
    .line { order: 4; width: auto; font-size: 16px; line-height: 1.5; margin: 22px 0 0; }
    .cta-row { order: 5; margin-top: 24px; }
    .cta { height: 48px; padding: 0 20px; font-size: 15px; }
    .editorial-frame { aspect-ratio: 1.08 / 1; }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
    .editorial-portrait { animation: hero-float 9s var(--ease) infinite alternate; }
    @keyframes hero-float {
      from { transform: translate3d(0,-2px,0) scale(1); }
      to { transform: translate3d(0,-7px,0) scale(1.006); }
    }
  }
  @media (max-width: 380px) {
    h1 { font-size: clamp(52px, 17vw, 64px); }
    .skills { letter-spacing: .05em; }
  }
</style>
