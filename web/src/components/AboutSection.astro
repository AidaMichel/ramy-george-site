---
import {getSite, section, linkHref, isExternal} from '../lib/content'
import Img from './Img.astro'
interface Props { num: string }
const site = await getSite()
const sec = section(site, 'about')
const a = site.about
const links = a.links.map((l) => ({...l, href: linkHref(site, l.kind, l.url)})).filter((l) => l.href)
const homepageCopy = a.homepageParagraph || "I’m Ramy, a video generalist based in Dubai. Editing is where I spend most of my time, but I also work across motion, design, sound and camera. I’ve worked on everything from news and documentaries to podcasts, social content and branded work."
---
<section id="about" class:list={['sec wrap about', {solo: !a.portrait?.src}]} aria-labelledby="about-h">
  {a.portrait?.src && (
    <div class="portrait"><Img img={a.portrait} alt={a.portrait.alt || site.settings.siteName} class="cover" sizes="(max-width: 719px) 300px, 432px" /></div>
  )}
  <div class="copy">
    <h2 class="sec-num" id="about-h">{Astro.props.num ? `${Astro.props.num} · ` : ''}{sec?.heading || a.heading}</h2>
    <p class="para">{homepageCopy}</p>
    {links.length > 0 && (
      <ul class="links">{links.map((l) => {
        const ext = isExternal(l.href) || l.kind === 'cv'
        const arrow = ext && !/[↗→]\s*$/.test(l.label) ? ' ↗' : ''
        return <li><a class="ext" href={l.href} {...(ext ? {target: '_blank', rel: 'noopener noreferrer'} : {})}>{l.label}{arrow}</a></li>
      })}</ul>
    )}
  </div>
</section>
<style>
  .about { display: grid; grid-template-columns: minmax(300px, 420px) minmax(0, 620px); justify-content: space-between; align-items: start; gap: clamp(52px, 7vw, 104px); }
  .portrait { width: 100%; aspect-ratio: 3 / 4; background: var(--s1); overflow: hidden; }
  .portrait :global(img) { object-position: 55% 40%; }
  .copy { min-width: 0; max-width: 620px; }
  .solo { grid-template-columns: minmax(0, 680px); justify-content: end; }
  .solo .copy { max-width: 680px; }
  .para { font-size: clamp(20px, 1.7vw, 24px); line-height: 1.52; font-weight: 500; letter-spacing: -0.01em; max-width: 44ch; text-wrap: pretty; }
  .links { list-style: none; padding: 0; margin: 32px 0 0; display: flex; gap: 26px; flex-wrap: wrap; align-items: baseline; }
  @media (max-width: 1023px) {
    .about { grid-template-columns: 1fr; justify-content: start; gap: 26px; }
    .portrait { width: min(340px, 100%); }
    .copy { max-width: 680px; }
  }
  @media (max-width: 719px) { .para { font-size: 18px; line-height: 1.56; max-width: none; } .links { gap: 22px; margin-top: 26px; } }
</style>
