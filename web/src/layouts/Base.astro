---
import '../styles/global.css'
import {getSite, navHref, isExternal, type Seo} from '../lib/content'
interface Props { seo?: Seo; title?: string; description?: string; image?: string; schema?: Record<string, any> | Record<string, any>[] }
const site = await getSite()
const {title, description, image} = Astro.props
const seo = Astro.props.seo || {}
const d = site.settings.seo
const fallbackTitle = title || d.title || site.settings.siteName
const requestedTitle = (seo.title || '').trim()
const pageTitle = requestedTitle.length >= 15 && requestedTitle.length <= 70 ? requestedTitle : fallbackTitle
const fallbackDesc = (description || d.description || '').trim()
const requestedDesc = (seo.description || '').trim()
const desc = requestedDesc.length >= 50 && requestedDesc.length <= 180 ? requestedDesc : fallbackDesc
const og = seo.ogImage || image || d.ogImage
const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '') + '/'
const siteBase = Astro.site || new URL(site.settings.siteUrl || Astro.url.origin)
const canonical = new URL(canonicalPath, siteBase).href
const absolute = (url?: string) => url ? (url.startsWith('/') ? new URL(url, siteBase).href : url) : undefined
const ogAbs = absolute(og)
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const noIndex = Boolean(seo.noIndex || d.noIndex)
const homeHasContact = site.home.sections.some((s) => s.key === 'contact' && s.visible !== false)
const logo = site.settings.logo
const faviconHref = site.settings.favicon || '/favicon.svg?v=10'
const flogo = site.settings.footerLogo?.src ? site.settings.footerLogo : logo
const f = site.settings.footer
const c = site.contact
const quick = [
  c.email && {label: 'Email', href: `mailto:${c.email}`, ext: false},
  c.whatsapp && {label: 'WhatsApp', href: c.whatsapp, ext: true},
  c.linkedin && {label: 'LinkedIn', href: c.linkedin, ext: true},
].filter(Boolean) as {label: string; href: string; ext: boolean}[]
const navItems = site.navigation
  .filter((n) => n.visible !== false)
  .map((n) => {
    const defaultHref = navHref(n.target, n.url)
    const href = n.target === 'contact'
      ? (path === '/info' ? '#contact' : path === '/' && homeHasContact ? '#contact' : homeHasContact ? '/#contact' : '/info/#contact')
      : defaultHref
    const ext = isExternal(href)
    const hrefPath = href.startsWith('#') || ext ? '' : (href.split('#')[0].replace(/\/+$/, '') || '/')
    const current = !ext && !href.startsWith('#') && (hrefPath === '/' ? path === '/' : path === hrefPath || path.startsWith(hrefPath + '/'))
    return {...n, href, ext, current}
  })
const primaryNav = navItems.filter((n) => !n.highlight)
const navCta = navItems.find((n) => n.highlight)
const extAttrs = {target: '_blank', rel: 'noopener noreferrer'}
const origin = siteBase.origin
const personId = `${origin}/#person`
const websiteId = `${origin}/#website`
const pageId = `${canonical}#webpage`
const personImage = absolute(site.about.portrait?.src || site.hero.image?.src)
const locationName = (site.settings.location || '').replace(/^Based in\s+/i, '').trim()
const personSchema = {
  '@type': 'Person',
  '@id': personId,
  name: site.settings.siteName,
  url: new URL('/', siteBase).href,
  jobTitle: site.settings.professionalTitle,
  description: site.about.paragraph || desc,
  ...(personImage ? {image: personImage} : {}),
  ...(site.contact.linkedin ? {sameAs: [site.contact.linkedin]} : {}),
  ...(site.settings.supportingSkills?.length ? {knowsAbout: site.settings.supportingSkills} : {}),
  ...(locationName ? {homeLocation: {'@type': 'Place', name: locationName}} : {}),
}
const websiteSchema = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: new URL('/', siteBase).href,
  name: site.settings.siteName,
  description: d.description || desc,
  publisher: {'@id': personId},
  inLanguage: 'en',
}
const pageType = path === '/info' ? 'ProfilePage' : path === '/work' ? 'CollectionPage' : 'WebPage'
const pageSchema = {
  '@type': pageType,
  '@id': pageId,
  url: canonical,
  name: pageTitle,
  ...(desc ? {description: desc} : {}),
  isPartOf: {'@id': websiteId},
  ...(path === '/info' ? {mainEntity: {'@id': personId}} : {}),
  inLanguage: 'en',
}
const extraSchema = Astro.props.schema
  ? (Array.isArray(Astro.props.schema) ? Astro.props.schema : [Astro.props.schema])
  : []
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [websiteSchema, personSchema, pageSchema, ...extraSchema],
}).replace(/</g, '\\u003c')
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  {desc && <meta name="description" content={desc} />}
  <meta name="author" content={site.settings.siteName} />
  <meta name="robots" content={noIndex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
  {site.settings.googleSiteVerification && <meta name="google-site-verification" content={site.settings.googleSiteVerification} />}
  {site.settings.bingSiteVerification && <meta name="msvalidate.01" content={site.settings.bingSiteVerification} />}
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  {site.contact.linkedin && <link rel="me" href={site.contact.linkedin} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.settings.siteName} />
  <meta property="og:locale" content="en_AE" />
  <meta property="og:title" content={pageTitle} />
  {desc && <meta property="og:description" content={desc} />}
  {ogAbs && <meta property="og:image" content={ogAbs} />}
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content={ogAbs ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={pageTitle} />
  {desc && <meta name="twitter:description" content={desc} />}
  {ogAbs && <meta name="twitter:image" content={ogAbs} />}
  <meta name="theme-color" content="#161513" />
  <script type="application/ld+json" set:html={structuredData}></script>
  <link rel="icon" href={faviconHref} />
  <link rel="shortcut icon" href={faviconHref} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class:list={['nav', 'wrap', {'home-nav': path === '/'}]}>
    <a href="/" class="brand" aria-label={`${site.settings.siteName}, home`}>
      {logo?.src ? <img src={logo.src} width={logo.w} height={logo.h} alt={site.settings.siteName} /> : <span>{site.settings.siteName}</span>}
    </a>
    <nav aria-label="Main" class="desk">
      <ul>
        {primaryNav.map((n) => <li><a href={n.href} aria-current={n.current ? 'page' : undefined} {...(n.ext ? extAttrs : {})}>{n.label}</a></li>)}
      </ul>
    </nav>
    {navCta && <a class="nav-cta" href={navCta.href} aria-current={navCta.current ? 'page' : undefined} {...(navCta.ext ? extAttrs : {})}>{navCta.label}<span aria-hidden="true">↗</span></a>}
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>Menu</button>
    <nav id="mobile-menu" class="mobile" aria-label="Main" hidden data-menu>
      <ul class="big-links">
        {navItems.map((n) => <li><a href={n.href} class:list={[{acc: n.highlight}]} aria-current={n.current ? 'page' : undefined} {...(n.ext ? extAttrs : {})}>{n.label}</a></li>)}
      </ul>
      {quick.length > 0 && <ul class="quick">{quick.map((q) => <li><a class="ext" href={q.href} {...(q.ext ? extAttrs : {})}>{q.label}{q.ext ? ' ↗' : ''}</a></li>)}</ul>}
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot wrap">
    {site.settings.showFooterSignature && flogo?.src && <a href="#main" class="sig" aria-label={`${site.settings.siteName}, back to top`}><img src={flogo.src} width={flogo.w} height={flogo.h} alt="" loading="lazy" /></a>}
    <div class="row muted">
      <span>{new Date().getFullYear()}· {f.creditLine || 'All thumbnails created by me'}{f.locationLine ? ` · ${f.locationLine}` : ''}</span>
      {f.showEmail && c.email && <a href={`mailto:${c.email}`} class="muted">{c.email}</a>}
      <a href="#main" class="muted">{f.backToTopLabel || 'Back to top ↑'}</a>
    </div>
  </footer>
  <script>
    // Mobile menu: a plain disclosure (button + panel). Closes on Escape, on link tap, and when the screen widens.
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')
    const panel = document.querySelector<HTMLElement>('[data-menu]')
    if (btn && panel) {
      const set = (open: boolean) => {
        panel.hidden = !open
        btn.setAttribute('aria-expanded', String(open))
        btn.textContent = open ? 'Close' : 'Menu'
      }
      btn.addEventListener('click', () => set(panel.hidden))
      panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false) })
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus() } })
      matchMedia('(min-width: 900px)').addEventListener('change', (m) => { if (m.matches) set(false) })
    }
  </script>
</body>
</html>
<style>
  .nav {
    height: 76px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--border);
    max-width: none;
    position: relative;
    z-index: 40;
    background: var(--bg);
  }
  .brand { grid-column: 1; justify-self: start; display: flex; align-items: center; padding: 10px 0; }
  .brand img { height: 24px; width: auto; }
  .desk {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: max-content;
    max-width: calc(100% - 520px);
  }
  .desk ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(26px, 3.2vw, 44px);
    white-space: nowrap;
  }
  .desk a {
    position: relative;
    display: inline-block;
    padding: 12px 0;
    font-size: 16px;
    transition: color var(--dur-fast) var(--ease);
  }
  .desk a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    background: var(--acc);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms var(--ease);
  }
  .desk a[aria-current='page']::after { transform: scaleX(1); }
  .nav-cta {
    grid-column: 3;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--control-sm);
    padding: 0 16px;
    border: 1px solid color-mix(in srgb, var(--acc) 80%, transparent);
    border-radius: var(--radius-pill);
    color: var(--acc);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }
  .nav-cta {
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .nav-cta:hover { color: var(--text); border-color: var(--text); transform: translateY(-1px); }
  .home-nav { border-bottom-color: transparent; }
  .menu-btn, .mobile { display: none; }
  .foot { padding-top: 48px; padding-bottom: 32px; border-top: 1px solid var(--border); max-width: none; }
  .sig { display: inline-block; }
  .sig img { width: min(340px, 60vw); height: auto; opacity: .9; }
  .row { display: flex; justify-content: space-between; gap: 16px; font-size: 14px; margin-top: 36px; flex-wrap: wrap; }
  @media (max-width: 899px) {
    .nav { height: 64px; display: flex; justify-content: space-between; }
    .brand img { height: 18px; }
    .desk, .nav-cta { display: none; }
    .menu-btn { display: inline-flex; align-items: center; height: 40px; padding: 0 16px; background: transparent; border: 1px solid var(--border); border-radius: var(--radius-pill); font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
    .mobile:not([hidden]) { display: block; position: absolute; left: 0; right: 0; top: 64px; background: var(--bg); border-bottom: 1px solid var(--border); padding: 12px var(--gutter) 28px; }
    .big-links { list-style: none; margin: 0; padding: 0; }
    .big-links a { display: block; padding: 8px 0; font-size: 40px; font-weight: 600; letter-spacing: -0.02em; }
    .big-links a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--acc); text-underline-offset: 6px; }
    .quick { list-style: none; margin: 22px 0 0; padding: 18px 0 0; border-top: 1px solid var(--rule); display: flex; gap: 22px; flex-wrap: wrap; }
    .foot { padding-top: 36px; padding-bottom: 28px; }
    .sig img { width: 220px; }
    .row { font-size: 13px; margin-top: 28px; }
  }
</style>
