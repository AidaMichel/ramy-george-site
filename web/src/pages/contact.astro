---
import Base from '../layouts/Base.astro'
import ContactSection from '../components/ContactSection.astro'
import {getSite} from '../lib/content'
const site = await getSite()
---
<Base seo={site.contact.seo} title={`Contact — ${site.settings.siteName}`} description={`Get in touch with ${site.settings.siteName}, ${site.settings.professionalTitle.toLowerCase()} ${site.settings.location.toLowerCase()}.`}>
  <ContactSection standalone />
</Base>
