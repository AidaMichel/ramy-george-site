---
import Base from '../../layouts/Base.astro'
import Img from '../../components/Img.astro'
import {getSite} from '../../lib/content'
const site = await getSite()
const onWork = site.projects.filter((p) => p.showOnWork)
const groups = [
  ...site.categories.map((c) => ({id: c.slug, title: c.title, items: onWork.filter((p) => p.kind === 'video' && p.category === c.slug)})),
  {id: 'motion-ai', title: 'Motion & AI', items: onWork.filter((p) => p.kind === 'motion')},
  {id: 'posts-carousels', title: 'Posts & Carousels', items: onWork.filter((p) => p.kind === 'post')},
].filter((g) => g.items.length > 0)
const total = groups.reduce((n, g) => n + g.items.length, 0)
---
<Base title={`Work — ${site.settings.siteName}`} description={`Selected video editing, motion and design work by ${site.settings.siteName}.`}>
  <div class="wrap page">
    <div class="head">
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h1 class="h1">Work</h1>
      </div>
      {total > 0 && <p class="muted count">{String(total).padStart(2, '0')} projects</p>}
    </div>

    {groups.length > 1 && (
      <nav class="jump" aria-label="Jump to a format">
        <ul>{groups.map((g) => <li><a class="pill" href={`#${g.id}`}>{g.title}<span class="c">{String(g.items.length).padStart(2, '0')}</span></a></li>)}</ul>
      </nav>
    )}

    {groups.length > 0 ? groups.map((g) => (
      <section id={g.id} class="grp" aria-labelledby={`${g.id}-h`}>
        <div class="gh">
          <h2 id={`${g.id}-h`}>{g.title}</h2>
          <span class="muted num">{String(g.items.length).padStart(2, '0')}</span>
        </div>
        <ul class="grid">
          {g.items.map((p) => (
            <li>
              <a href={`/work/${p.slug}/`} class="card">
                <span class="thumb media"><Img img={p.cover || p.poster} alt={p.title} class="contain" sizes="(max-width: 719px) 100vw, (max-width: 1199px) 50vw, 33vw" /></span>
                <span class="ct">{p.title}</span>
                {p.org && <span class="co muted">{p.org}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )) : (
      <section class="empty" role="status">
        <p class="eyebrow">WORK IN PROGRESS</p>
        <h2>Selected work is being updated.</h2>
        <p class="muted">Published projects will appear here automatically.</p>
        <a class="ext" href="/">Back to the homepage</a>
      </section>
    )}
  </div>
</Base>
<style>
  .page { padding-top: clamp(52px, 7vw, 92px); padding-bottom: clamp(96px, 10vw, 144px); }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .eyebrow { color: var(--acc); font-size: 11px; font-weight: 700; letter-spacing: .14em; }
  .h1 { margin-top: 12px; font-size: clamp(56px, 9vw, 128px); line-height: .9; font-weight: 600; letter-spacing: -0.045em; }
  .count { font-size: 14px; padding-bottom: 10px; }
  .jump ul { list-style: none; margin: 34px 0 0; padding: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .jump .pill { display: inline-flex; align-items: center; }
  .jump .pill:hover { border-color: var(--acc); color: var(--text); }
  .grp { padding-top: clamp(72px, 8vw, 104px); scroll-margin-top: 24px; }
  .gh { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--text); margin-bottom: 24px; }
  .gh h2 { font-size: 14px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .gh .num { font-size: 12px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 40px var(--gap); }
  .card { display: block; min-width: 0; }
  .thumb { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 10; }
  .thumb :global(img) { max-height: 100%; max-width: 100%; object-fit: contain; }
  .ct { display: block; margin-top: 12px; font-size: 18px; font-weight: 600; line-height: 1.25; }
  .co { display: block; font-size: 14px; margin-top: 3px; }
  .card:hover .ct { color: var(--acc); }
  .empty { margin-top: 64px; padding: clamp(42px, 6vw, 72px) 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .empty h2 { margin-top: 14px; font-size: clamp(34px, 4vw, 54px); line-height: 1; letter-spacing: -.03em; }
  .empty .muted { margin-top: 12px; max-width: 520px; }
  .empty .ext { display: inline-block; margin-top: 30px; }
  @media (max-width: 719px) {
    .head { align-items: flex-start; }
    .count { display: none; }
    .jump { margin-inline: calc(var(--gutter) * -1); overflow: hidden; }
    .jump ul { flex-wrap: nowrap; overflow-x: auto; padding-inline: var(--gutter); scrollbar-width: none; }
    .jump ul::-webkit-scrollbar { display: none; }
  }
</style>
