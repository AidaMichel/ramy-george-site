---
import Base from '../../layouts/Base.astro'
import Img from '../../components/Img.astro'
import {getSite, watchLabel, embedUrl, ratio, type Project} from '../../lib/content'

const site = await getSite()
const slug = Astro.params.slug
const p = site.projects.find((x) => x.slug === slug) as Project | undefined
if (!p) return Astro.redirect('/404', 302)
const cat = site.categories.find((c) => c.slug === p.category)
const kindLabel = p.kind === 'video' ? `Editing${cat ? ' · ' + cat.title : ''}` : p.kind === 'motion' ? 'Motion & AI' : 'Posts & Carousels'
const embed = p.watchUrl ? embedUrl(p.watchUrl) : ''
const motionLoop = p.kind === 'motion' ? (p.previewLoop || p.hoverPreview || '') : ''
const mainAspect = p.kind === 'post' ? (p.slideAspect || '4:5') : (p.aspect || '16:9')
const mainShape = mainAspect === '9:16' ? 'vertical' : ['4:5', '3:4'].includes(mainAspect) ? 'portrait' : mainAspect === '1:1' ? 'square' : 'wide'
const siblings = site.projects.filter((x) => x.showOnWork && x.kind === p.kind && (p.kind !== 'video' || x.category === p.category))
const i = siblings.findIndex((x) => x.slug === p.slug)
const prev = siblings[i - 1], next = siblings[i + 1]
const related = siblings.filter((x) => x.slug !== p.slug).slice(0, 3)
const discipline = p.kind === 'video' ? 'video editing' : p.kind === 'motion' ? 'motion and AI work' : 'design and carousel work'
const desc = p.seo?.description || p.summary || `${p.title}${p.org ? ' for ' + p.org : ''} — ${discipline} by ${site.settings.siteName} in Dubai.`
---
<Base seo={p.seo} title={`${p.title}${p.org ? ' — ' + p.org : ''} · ${site.settings.siteName}`} description={desc} image={(p.cover || p.poster)?.src}>
  <article class="wrap proj">
    <a class="back" href={p.kind === 'video' && cat ? `/work/#${cat.slug}` : '/work/'} aria-label="Back to Work">
      <span class="back-arrow" aria-hidden="true">←</span>
      <span>Back to Work</span>
    </a>
    <header class="hd">
      <p class="lbl">{kindLabel}</p>
      <h1>{p.title}</h1>
      {p.org && <p class="org">{p.org}</p>}
    </header>

    <div class:list={['player', mainShape]} data-player style={`--ar:${ratio(mainAspect)}`}>
      <div class="frame media">
        {motionLoop
          ? <video class="motion-loop" src={motionLoop} poster={p.poster?.src} muted loop playsinline autoplay preload="metadata" aria-label={`${p.title} preview`} data-motion-loop></video>
          : p.kind === 'post' && p.slides?.length
            ? <Img img={p.slides[0]} alt={p.slides[0]?.alt || p.title} class="contain" eager />
            : <Img img={p.poster} alt={p.poster?.alt || p.title} class="contain" eager sizes="(max-width: 1023px) 100vw, 80vw" />}
        {embed && (
          <button type="button" class="play" data-embed={embed} aria-label={`Play ${p.title}`}>
            <span class="play-icon" aria-hidden="true"><span class="tri"></span></span>
            <span class="play-label">Play video</span>
          </button>
        )}
      </div>
      {embed && <p class="note muted">Plays from {p.platform}. Nothing loads from {p.platform} until you press play.</p>}
    </div>

    <div class="info">
      <dl>
        {p.role && <><dt class="lbl">Role</dt><dd>{p.role}</dd></>}
        {p.org && <><dt class="lbl">For</dt><dd>{p.org}</dd></>}
        {p.credits && <><dt class="lbl">Credits</dt><dd class="pre">{p.credits}</dd></>}
      </dl>
      <div class="side">
        {p.summary && <p class="sum">{p.summary}</p>}
        <div class="acts">
          {p.watchUrl && <a class="ext" href={p.watchUrl} target="_blank" rel="noopener noreferrer">{watchLabel(p)}</a>}
          {p.secondScreen?.url && <a class="ext" href={p.secondScreen.url} target="_blank" rel="noopener noreferrer">{p.secondScreen.watchLabel}</a>}
        </div>
      </div>
    </div>

    {p.secondScreen && (
      <section class="two" aria-label="Two screens">
        <figure><div class="media sc" style="--ar:16 / 9"><Img img={p.poster} alt="" class="cover" /></div><figcaption class="lbl">16:9 episode</figcaption></figure>
        <figure><div class="media sc" style={`--ar:${ratio(p.secondScreen.aspect)}`}><Img img={p.secondScreen.poster} alt="" class="cover" /></div><figcaption class="lbl">{p.secondScreen.label}</figcaption></figure>
      </section>
    )}

    {p.kind === 'post' && p.slides && p.slides.length > 1 && (
      <ol class="slides">{p.slides.map((s, k) => <li style={`--ar:${ratio(p.slideAspect || '4:5')}`}><Img img={s} alt={s?.alt || `Slide ${k + 1}`} class="cover" /><span class="num muted">{String(k + 1).padStart(2, '0')} / {String(p.slides!.length).padStart(2, '0')}</span></li>)}</ol>
    )}

    <nav class="pn" aria-label="More projects">
      {prev ? <a href={`/work/${prev.slug}/`}><span class="lbl">Previous</span><span>{prev.title}</span></a> : <span></span>}
      {next ? <a class="r" href={`/work/${next.slug}/`}><span class="lbl">Next</span><span>{next.title}</span></a> : <span></span>}
    </nav>

    {related.length > 0 && (
      <section class="rel" aria-labelledby="rel-h">
        <h2 id="rel-h" class="lbl">Related work</h2>
        <ul>{related.map((r) => <li><a href={`/work/${r.slug}/`}><span class="media rt"><Img img={r.cover || r.poster} alt={r.title} class="contain" sizes="33vw" /></span><b>{r.title}</b><span class="muted">{r.org}</span></a></li>)}</ul>
      </section>
    )}
  </article>
</Base>
<script>
  // Click-to-load player: the Vimeo/YouTube iframe (and its cookies) only loads after the visitor asks for it.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-motion-loop]').forEach((v) => v.pause())
  }
  document.querySelectorAll<HTMLButtonElement>('[data-embed]').forEach((b) => b.addEventListener('click', () => {
    const frame = b.parentElement!
    const f = document.createElement('iframe')
    f.src = b.dataset.embed!
    f.title = b.getAttribute('aria-label')!.replace('Play ', '') + ' — video player'
    f.allow = 'autoplay; fullscreen; picture-in-picture'
    f.allowFullscreen = true
    f.referrerPolicy = 'strict-origin-when-cross-origin'
    frame.replaceChildren(f)
    f.focus()
  }))
</script>
<style>
  .proj { padding-top: 32px; padding-bottom: 120px; }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    padding: 7px 14px 7px 9px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .back-arrow {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--acc);
    color: var(--bg);
    font-size: 17px;
    line-height: 1;
    transition: transform 160ms ease;
  }
  .back:hover,
  .back:focus-visible {
    background: var(--acc);
    border-color: var(--acc);
    color: var(--bg);
  }
  .back:hover .back-arrow,
  .back:focus-visible .back-arrow {
    background: var(--bg);
    color: var(--acc);
    transform: translateX(-2px);
  }
  .hd { margin-top: 34px; }
  h1 { margin-top: 12px; font-size: clamp(40px, 6vw, 88px); line-height: .95; font-weight: 600; letter-spacing: -0.035em; max-width: 18ch; }
  .org { margin-top: 12px; font-size: 20px; color: var(--muted); }
  .player { margin-top: 48px; }
  .frame { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: var(--ar); width: 100%; overflow: hidden; }
  .player.portrait .frame { width: min(680px, 100%); margin-inline: auto; }
  .player.vertical .frame { width: min(520px, 100%); margin-inline: auto; }
  .player.square .frame { width: min(820px, 100%); margin-inline: auto; }
  .frame :global(img), .motion-loop { max-height: 100%; max-width: 100%; width: 100%; height: 100%; object-fit: contain; }
  .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 8px 22px 8px 8px;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    box-shadow: 0 14px 34px rgba(0,0,0,.28);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }
  .play:hover,
  .play:focus-visible {
    background: var(--acc);
    border-color: var(--acc);
    transform: translate(-50%, -50%) scale(1.035);
  }
  .play-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 50%;
    background: var(--acc);
    color: var(--bg);
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .play:hover .play-icon,
  .play:focus-visible .play-icon {
    background: var(--bg);
    color: var(--acc);
    transform: scale(.96);
  }
  .play-label { white-space: nowrap; }
  .tri {
    width: 0;
    height: 0;
    margin-left: 3px;
    border-left: 13px solid currentColor;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
  }
  .note { font-size: 13px; margin-top: 10px; }
  .info { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gap); margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--rule); }
  dl { margin: 0; display: grid; grid-template-columns: 120px 1fr; gap: 14px 16px; }
  dd { margin: 0; } .pre { white-space: pre-line; }
  .sum { font-size: 20px; line-height: 1.5; margin-bottom: 24px; }
  .acts { display: flex; gap: 24px; flex-wrap: wrap; }
  .two { display: flex; gap: 16px; align-items: flex-end; margin-top: 72px; }
  .two figure { margin: 0; } .sc { height: clamp(220px, 30vw, 420px); aspect-ratio: var(--ar); } .two figcaption { margin-top: 10px; }
  .slides { list-style: none; padding: 0; margin: 72px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .slides li { aspect-ratio: var(--ar); position: relative; background: var(--media); }
  .slides .num { position: absolute; left: 8px; bottom: 8px; font-size: 12px; background: var(--bg); padding: 2px 6px; }
  .pn { display: flex; justify-content: space-between; gap: 24px; margin-top: 96px; padding-top: 24px; border-top: 1px solid var(--text); }
  .pn a { display: flex; flex-direction: column; gap: 6px; font-size: 20px; font-weight: 600; max-width: 45%; }
  .pn .r { text-align: right; }
  .rel { margin-top: 96px; }
  .rel ul { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .rel a { display: flex; flex-direction: column; gap: 4px; }
  .rt { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 10; margin-bottom: 8px; }
  .rt :global(img) { max-height: 100%; }
  .rel a:hover b { color: var(--acc); }
  @media (max-width: 1023px) { .info { grid-template-columns: 1fr; } .rel ul { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 599px) {
    .back { min-height: 38px; padding: 6px 12px 6px 7px; }
    .back-arrow { width: 25px; height: 25px; }
    .play { min-height: 56px; padding: 7px 18px 7px 7px; font-size: 15px; }
    .play-icon { width: 42px; height: 42px; }
    .rel ul { grid-template-columns: 1fr; }
    dl { grid-template-columns: 90px 1fr; }
  }
</style>
