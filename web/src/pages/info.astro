---
import Base from '../layouts/Base.astro'
import ContactSection from '../components/ContactSection.astro'
import Img from '../components/Img.astro'
import {getSite} from '../lib/content'
const site = await getSite()
const i = site.info
const intro = i.useAboutParagraph !== false ? site.about.paragraph : i.intro || site.about.paragraph
const portrait = i.showPortrait !== false ? site.about.portrait : null
const cv = i.showCv !== false ? site.settings.cv : ''
---
<Base seo={i.seo} title={`Info — ${site.settings.siteName}`} description={intro.slice(0, 155)}>
  <section class="wrap intro">
    <div class="lead">
      <h1>{i.heading || 'Info'}</h1>
      <p class="para">{intro}</p>
    </div>
    {portrait?.src && <div class="portrait"><Img img={portrait} alt={portrait.alt || site.settings.siteName} class="cover" eager sizes="(max-width: 719px) 300px, 432px" /></div>}
  </section>
  {(i.experience.length > 0 || i.training.length > 0 || cv) && (
    <section class="wrap cols">
      {i.experience.length > 0 && (
        <div class="exp">
          <h2 class="lbl">Experience</h2>
          <ul class="list">{i.experience.map((e) => (
            <li><div><div class="t">{e.role}</div><div class="muted sub">{[e.organisation, e.location].filter(Boolean).join(' · ')}</div></div><div class="num muted yr">{e.years}</div></li>
          ))}</ul>
        </div>
      )}
      <div class="trn">
        {i.training.length > 0 && <>
          <h2 class="lbl">Training &amp; education</h2>
          <ul class="list small">{i.training.map((t) => (
            <li><div><div class="t">{t.course}</div><div class="muted sub">{t.institution}</div></div><div class="num muted yr">{t.year}</div></li>
          ))}</ul>
        </>}
        {cv && <a class="ext muted cv" href={cv} target="_blank" rel="noopener noreferrer">{i.cvLabel || 'Download CV ↗'}</a>}
      </div>
    </section>
  )}
  <ContactSection />
</Base>
<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 380px); gap: clamp(40px, 7vw, 96px); align-items: start; padding-top: clamp(56px, 7vw, 96px); }
  .lead { min-width: 0; max-width: 780px; }
  h1 { font-size: clamp(64px, 9vw, 128px); line-height: .9; font-weight: 600; letter-spacing: -0.045em; }
  .para { margin-top: clamp(28px, 3.5vw, 48px); font-size: clamp(19px, 1.8vw, 25px); line-height: 1.5; font-weight: 500; letter-spacing: -0.01em; max-width: 52ch; text-wrap: pretty; }
  .portrait { width: 100%; aspect-ratio: 3 / 4; background: var(--s1); overflow: hidden; }
  .portrait :global(img) { object-position: 55% 40%; }
  .cols { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: calc(var(--gap) * 2); padding-top: clamp(96px, 10vw, 140px); align-items: start; }
  .lbl { font-size: 13px; font-weight: 600; letter-spacing: .12em; margin-bottom: 8px; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border-strong); }
  .list li { display: grid; grid-template-columns: 1fr 150px; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--border); }
  .list.small li { grid-template-columns: 1fr 110px; }
  .t { font-size: 19px; font-weight: 600; }
  .small .t { font-size: 17px; }
  .sub { font-size: 15px; margin-top: 4px; }
  .yr { font-size: 14px; text-align: right; }
  .cv { display: inline-block; margin-top: 36px; }
  @media (max-width: 1023px) {
    .intro { grid-template-columns: 1fr; }
    .lead { grid-row: 1; }
    .portrait { grid-row: 2; width: min(320px, 100%); margin-top: 6px; }
    .cols { grid-template-columns: 1fr; }
  }
  @media (max-width: 719px) { .list li, .list.small li { grid-template-columns: 1fr auto; gap: 16px; } .t { font-size: 17px; } }
</style>
