---
import Base from '../layouts/Base.astro'
Astro.response.status = 404
Astro.response.statusText = 'Not Found'
---
<Base title="Page not found" seo={{noIndex: true}}>
  <div class="wrap" style="padding-block:120px 160px">
    <h1 style="font-size:clamp(48px,8vw,112px);line-height:.9;font-weight:600;letter-spacing:-0.04em">Page not found.</h1>
    <p style="margin-top:24px"><a class="ext" href="/">Back to the homepage</a> &nbsp; <a class="ext" href="/work/">See the work</a></p>
  </div>
</Base>
