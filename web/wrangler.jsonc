// Cloudflare Worker with Astro on-demand rendering.
// Published Sanity content is read at request time, so dashboard changes do not require a website rebuild.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "ramy-george",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "ramygeorge.com", "custom_domain": true },
    { "pattern": "www.ramygeorge.com", "custom_domain": true }
  ],
  "env": {
    // Draft preview can still use its own worker later if needed.
    "preview": {
      "name": "ramy-george-preview"
    }
  }
}
