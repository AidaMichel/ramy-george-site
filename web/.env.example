# Copy to .env for local builds against Sanity. Leave SANITY_PROJECT_ID empty to build from the bundled seed content.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SITE_URL=https://ramygeorge.com
# Only for the private draft-preview build. Read-only "Viewer" token. Never a write token.
SANITY_PREVIEW=
SANITY_READ_TOKEN=
